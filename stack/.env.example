# Copy to .env, replace every change-me, then:  chmod 600 .env
# Generate each secret with:  openssl rand -hex 32
# Never commit or share .env. Back it up with n8n_data/: losing N8N_ENCRYPTION_KEY = all credentials unreadable.

# --- versions (pinned; change only on purpose)
N8N_VERSION=2.40.7
N8N_SANDBOX_VERSION=1.5.0

# --- host port (editor at http://localhost:<port>, this host only)
TZ=UTC                           # your timezone, e.g. Europe/Berlin
N8N_HOST_PORT=5678

# --- secrets (REQUIRED)
N8N_ENCRYPTION_KEY=change-me
N8N_RUNNERS_AUTH_TOKEN=change-me
SANDBOX_API_KEY=change-me
SANDBOX_RUNNER_REGISTRATION_TOKEN=change-me
SANDBOX_RUNNER_API_KEY=change-me

# --- executions
EXECUTIONS_DATA_MAX_AGE=5000     # hours kept (~208 days)
EXECUTIONS_TIMEOUT=900           # seconds, default per workflow

# --- n8n Assistant model: set in the UI (Settings > n8n Assistant).
#     Do NOT add N8N_INSTANCE_AI_MODEL* here: any env value locks the UI field.
